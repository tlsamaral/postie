{
  "name": "ticket-router-agent",
  "version": "1.0.0",
  "description": "Ticket Router Agent - Agente Autônomo de Roteamento de Tickets & Backlog",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:projects": "tsx scripts/sync-projects.ts",
    "select:projects": "tsx scripts/select-projects.ts"
  },
  "keywords": [
    "ticket-router",
    "ai-agent",
    "clean-architecture",
    "gemini",
    "github",
    "ms-graph"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@google/genai": "^2.22.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.4.2",
    "imapflow": "^2.0.3",
    "mailparser": "^3.9.26",
    "openai": "^7.15.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.5.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
