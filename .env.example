# Ambiente e Logging
NODE_ENV=development
LOG_LEVEL=info

# Provedor de Email Ativo: MS_GRAPH ou IMAP
EMAIL_PROVIDER=MS_GRAPH

# Microsoft 365 / Azure AD (Obrigatório se EMAIL_PROVIDER=MS_GRAPH)
# Guia de registro no Azure: https://learn.microsoft.com/en-us/azure/healthcare-apis/register-application
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your_azure_client_secret_here
MS_GRAPH_MAILBOX_USER=suporte@empresa.com

# Configuração IMAP alternativa (Necessário se EMAIL_PROVIDER=IMAP)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=suporte@example.com
IMAP_PASSWORD=your_imap_password
IMAP_TLS=true

# Provedor de IA: GEMINI ou OPENAI
AI_PROVIDER=GEMINI
GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...

# GitHub Personal Access Token ou GitHub App Token
GITHUB_AUTH_TOKEN=ghp_...

# Intervalo do Polling em segundos (mínimo 5s, padrão 60s)
POLLING_INTERVAL_SECONDS=60

# Email de destino para notificações e confirmações de triagem
ALERT_NOTIFICATION_EMAIL=responsavel-triagem@empresa.com
